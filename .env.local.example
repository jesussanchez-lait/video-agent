# ──────────────────────────────────────────────────────
# Firebase (cliente) — variables públicas
# ──────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD35avrv9uT7V9OkbshAa2WHUgg_VicikU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lait-video-editor.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lait-video-editor

# ──────────────────────────────────────────────────────
# Firebase Admin SDK (servidor)
# Opción A (recomendada): usa el archivo JSON del service account
# Coloca el JSON en la raíz del proyecto o define la ruta:
# ──────────────────────────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=lait-video-editor-firebase-adminsdk-fbsvc-feeabf3dcd.json

# Opción B: variables de entorno (descarga el JSON desde Firebase Console
# → Configuración → Cuentas de servicio → Generar nueva clave privada)
# ──────────────────────────────────────────────────────
# FIREBASE_PROJECT_ID=lait-video-editor
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lait-video-editor.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ──────────────────────────────────────────────────────
# Firebase Storage
# En consola verás gs://lait-video-editor.firebasestorage.app
# Aquí va SOLO el nombre del bucket (sin prefijo gs://):
# ──────────────────────────────────────────────────────
FIREBASE_STORAGE_BUCKET=lait-video-editor.firebasestorage.app

# ──────────────────────────────────────────────────────
# Sesión — clave secreta para firmar las cookies JWT
# Genera una con: openssl rand -base64 32
# ──────────────────────────────────────────────────────
SESSION_SECRET=tu_clave_secreta_de_al_menos_32_caracteres

# ──────────────────────────────────────────────────────
# Remotion Studio y API base
# ──────────────────────────────────────────────────────
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# ──────────────────────────────────────────────────────
# HeyGen (avatar video) + HyperFrames render worker (Fase 2)
# ──────────────────────────────────────────────────────
# HEYGEN_API_KEY=
# HEYGEN_DEFAULT_AVATAR_ID=
# HYPERFRAMES_RENDER_WORKER_URL=
